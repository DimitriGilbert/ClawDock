DATABASE_URL=postgresql://clawdock:clawdock_secret@localhost:5432/clawdock
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
OPENCODE_URL=http://localhost:4096
OPENCODE_PASSWORD=demo_password_12345

# Agent Files Directory (default: ./agents)
# Path to directory containing AGENTS.md, SOUL.md, GOALS.md, REFLECTION.md
AGENTS_DIR=./data/Clawthis/agents

# Optional: Docker Compose Project Name
# If set, only containers with label com.docker.compose.project=<NAME> will be shown (Stack Mode)
# If not set, ALL containers on the machine will be shown (All Containers Mode)
# UI toggle can override this setting
# COMPOSE_PROJECT_NAME=clawdock
